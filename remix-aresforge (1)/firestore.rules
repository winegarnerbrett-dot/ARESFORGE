rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'dailyCalorieGoal', 'dailyProteinGoal',
          'dailyCarbsGoal', 'dailyFatGoal', 'weeklyWorkoutGoal',
          'dailyWaterGoalMl', 'dailyStepGoal', 'dailyActiveCaloriesGoal',
          'targetWeightKg', 'currentWeightKg', 'unitSystem', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'dailyCalorieGoal', 'dailyProteinGoal',
          'dailyCarbsGoal', 'dailyFatGoal', 'macroMode', 'macroProteinPct',
          'macroCarbsPct', 'macroFatPct', 'weeklyWorkoutGoal',
          'dailyWaterGoalMl', 'dailyStepGoal', 'dailyActiveCaloriesGoal',
          'targetWeightKg', 'currentWeightKg', 'unitSystem', 'experienceLevel',
          'heightCm', 'age', 'biologicalSex', 'activityLevel', 'nutritionGoal',
          'activeProgramId', 'activeDailyDurationDate', 'activeDailyDurationMinutes',
          'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.dailyCalorieGoal is number && data.dailyCalorieGoal >= 800 && data.dailyCalorieGoal <= 10000
        && data.dailyProteinGoal is number && data.dailyProteinGoal >= 0 && data.dailyProteinGoal <= 1500
        && data.dailyCarbsGoal is number && data.dailyCarbsGoal >= 0 && data.dailyCarbsGoal <= 2500
        && data.dailyFatGoal is number && data.dailyFatGoal >= 0 && data.dailyFatGoal <= 1100
        && (!('macroMode' in data) || data.macroMode in ['recommended', 'custom'])
        && (!('macroProteinPct' in data) || (data.macroProteinPct is int && data.macroProteinPct >= 0 && data.macroProteinPct <= 100))
        && (!('macroCarbsPct' in data) || (data.macroCarbsPct is int && data.macroCarbsPct >= 0 && data.macroCarbsPct <= 100))
        && (!('macroFatPct' in data) || (data.macroFatPct is int && data.macroFatPct >= 0 && data.macroFatPct <= 100))
        && ((!('macroProteinPct' in data) && !('macroCarbsPct' in data) && !('macroFatPct' in data)) || (
          ('macroProteinPct' in data) && ('macroCarbsPct' in data) && ('macroFatPct' in data)
          && data.macroProteinPct + data.macroCarbsPct + data.macroFatPct == 100
        ))
        && data.weeklyWorkoutGoal is number && data.weeklyWorkoutGoal >= 1 && data.weeklyWorkoutGoal <= 14
        && data.dailyWaterGoalMl is number && data.dailyWaterGoalMl >= 500 && data.dailyWaterGoalMl <= 10000
        && data.dailyStepGoal is number && data.dailyStepGoal >= 1000 && data.dailyStepGoal <= 100000
        && data.dailyActiveCaloriesGoal is number && data.dailyActiveCaloriesGoal >= 100 && data.dailyActiveCaloriesGoal <= 5000
        && data.targetWeightKg is number && data.targetWeightKg >= 25 && data.targetWeightKg <= 350
        && data.currentWeightKg is number && data.currentWeightKg >= 25 && data.currentWeightKg <= 350
        && data.unitSystem in ['imperial', 'metric']
        && (!('experienceLevel' in data) || data.experienceLevel in ['Beginner', 'Intermediate', 'Advanced'])
        && (!('heightCm' in data) || (data.heightCm is number && data.heightCm >= 100 && data.heightCm <= 250))
        && (!('age' in data) || (data.age is number && data.age >= 13 && data.age <= 110))
        && (!('biologicalSex' in data) || data.biologicalSex in ['male', 'female', 'neutral'])
        && (!('activityLevel' in data) || data.activityLevel in ['sedentary', 'light', 'moderate', 'active', 'very_active'])
        && (!('nutritionGoal' in data) || data.nutritionGoal in ['lose_weight', 'maintain', 'build_muscle', 'recomp', 'performance'])
        && (!('activeProgramId' in data) || data.activeProgramId == '' || isValidId(data.activeProgramId))
        && (!('activeDailyDurationDate' in data) || data.activeDailyDurationDate == '' || isValidDateKey(data.activeDailyDurationDate))
        && (!('activeDailyDurationMinutes' in data) || data.activeDailyDurationMinutes in [30, 45, 60])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: CustomProgram
    function isValidCustomProgram(data, userId, programId) {
      return data.keys().hasAll([
          'id', 'userId', 'title', 'category', 'difficulty',
          'estimatedMinutes', 'daysPerWeek', 'description', 'exercises',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'title', 'category', 'difficulty',
          'estimatedMinutes', 'daysPerWeek', 'description', 'exercises',
          'createdAt', 'updatedAt'
        ])
        && data.id == programId
        && isValidId(data.id)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.category in ['Strength', 'Hypertrophy', 'Conditioning', 'Mobility', 'Custom']
        && data.difficulty in ['Beginner', 'Intermediate', 'Advanced']
        && data.estimatedMinutes is number && data.estimatedMinutes >= 5 && data.estimatedMinutes <= 300
        && data.daysPerWeek is number && data.daysPerWeek >= 1 && data.daysPerWeek <= 7
        && data.description is string && data.description.size() <= 300
        && data.exercises is list && data.exercises.size() >= 1 && data.exercises.size() <= 25
        && data.exercises[0] is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: WorkoutSession
    function isValidWorkoutSession(data, userId, sessionId) {
      return data.keys().hasAll([
          'id', 'userId', 'programId', 'programTitle', 'dateKey',
          'durationMinutes', 'caloriesBurned', 'totalVolumeKg', 'completedSets',
          'exercisesSummary', 'notes', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'programId', 'programTitle', 'dateKey',
          'durationMinutes', 'caloriesBurned', 'totalVolumeKg', 'completedSets',
          'exercisesSummary', 'notes', 'createdAt'
        ])
        && data.id == sessionId
        && isValidId(data.id)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.programId is string && data.programId.size() >= 1 && data.programId.size() <= 128
        && data.programTitle is string && data.programTitle.size() >= 1 && data.programTitle.size() <= 80
        && isValidDateKey(data.dateKey)
        && data.durationMinutes is number && data.durationMinutes >= 1 && data.durationMinutes <= 600
        && data.caloriesBurned is number && data.caloriesBurned >= 0 && data.caloriesBurned <= 5000
        && data.totalVolumeKg is number && data.totalVolumeKg >= 0 && data.totalVolumeKg <= 500000
        && data.completedSets is number && data.completedSets >= 0 && data.completedSets <= 300
        && data.exercisesSummary is list && data.exercisesSummary.size() <= 25
        && (data.exercisesSummary.size() == 0 || data.exercisesSummary[0] is map)
        && data.notes is string && data.notes.size() <= 300
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: NutritionEntry
    function isValidNutritionEntry(data, userId, entryId) {
      return data.keys().hasAll([
          'id', 'userId', 'dateKey', 'mealType', 'name', 'brand',
          'barcode', 'servingLabel', 'servings', 'calories',
          'proteinG', 'carbsG', 'fatG', 'source', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'dateKey', 'mealType', 'name', 'brand',
          'barcode', 'servingLabel', 'servings', 'calories',
          'proteinG', 'carbsG', 'fatG', 'source', 'createdAt'
        ])
        && data.id == entryId
        && isValidId(data.id)
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidDateKey(data.dateKey)
        && data.mealType in ['breakfast', 'lunch', 'dinner', 'snack']
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.brand is string && data.brand.size() <= 80
        && data.barcode is string && data.barcode.size() <= 40
        && data.servingLabel is string && data.servingLabel.size() >= 1 && data.servingLabel.size() <= 60
        && data.servings is number && data.servings >= 0.1 && data.servings <= 50
        && data.calories is number && data.calories >= 0 && data.calories <= 10000
        && data.proteinG is number && data.proteinG >= 0 && data.proteinG <= 1000
        && data.carbsG is number && data.carbsG >= 0 && data.carbsG <= 1000
        && data.fatG is number && data.fatG >= 0 && data.fatG <= 1000
        && data.source in ['barcode', 'search', 'manual']
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: DailyMetric
    function isValidDailyMetric(data, userId, dateKey) {
      return data.keys().hasAll([
          'userId', 'dateKey', 'waterMl', 'weightKg', 'steps',
          'activeCalories', 'restingHeartRate', 'avgHeartRate',
          'wearableSource', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'dateKey', 'waterMl', 'weightKg', 'steps',
          'activeCalories', 'restingHeartRate', 'avgHeartRate',
          'wearableSource', 'updatedAt'
        ])
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidDateKey(data.dateKey)
        && data.dateKey == dateKey
        && data.waterMl is number && data.waterMl >= 0 && data.waterMl <= 15000
        && data.weightKg is number && data.weightKg >= 0 && data.weightKg <= 400
        && data.steps is number && data.steps >= 0 && data.steps <= 200000
        && data.activeCalories is number && data.activeCalories >= 0 && data.activeCalories <= 15000
        && data.restingHeartRate is number && data.restingHeartRate >= 0 && data.restingHeartRate <= 240
        && data.avgHeartRate is number && data.avgHeartRate >= 0 && data.avgHeartRate <= 240
        && data.wearableSource in ['manual', 'fitbit', 'apple_health', 'garmin', 'strava', 'bluetooth_hr']
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: ProgramPreference
    function isValidProgramPreference(data, userId, programId) {
      return data.keys().hasAll(['userId', 'programId', 'rotationDays', 'targetMinutes', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'programId', 'rotationDays', 'targetMinutes', 'exerciseSwaps', 'updatedAt'])
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.programId)
        && data.programId == programId
        && data.rotationDays is number && data.rotationDays >= 3 && data.rotationDays <= 7
        && data.targetMinutes in [30, 45, 60]
        && (!('exerciseSwaps' in data) || (data.exerciseSwaps is map && data.exerciseSwaps.size() <= 40))
        && data.updatedAt is timestamp;
    }

    // User Profile Match Block
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'dailyCalorieGoal', 'dailyProteinGoal',
          'dailyCarbsGoal', 'dailyFatGoal', 'macroMode', 'macroProteinPct',
          'macroCarbsPct', 'macroFatPct', 'weeklyWorkoutGoal',
          'dailyWaterGoalMl', 'dailyStepGoal', 'dailyActiveCaloriesGoal',
          'targetWeightKg', 'currentWeightKg', 'unitSystem', 'experienceLevel',
          'heightCm', 'age', 'biologicalSex', 'activityLevel', 'nutritionGoal',
          'activeProgramId', 'activeDailyDurationDate', 'activeDailyDurationMinutes',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);

      // Subcollection: Custom Workout Programs
      match /customPrograms/{programId} {
        allow get: if isValidId(userId) && isValidId(programId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(programId)
          && isOwner(userId)
          && isValidCustomProgram(incoming(), userId, programId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow update: if isValidId(userId)
          && isValidId(programId)
          && isOwner(userId)
          && isValidCustomProgram(incoming(), userId, programId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'category', 'difficulty', 'estimatedMinutes',
            'daysPerWeek', 'description', 'exercises', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(programId) && isOwner(userId);
      }

      // Subcollection: Workout Sessions
      match /workoutSessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId)
          && isValidWorkoutSession(incoming(), userId, sessionId)
          && incoming().createdAt == request.time
          && parentUserExists(userId);
        allow update: if isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId)
          && isValidWorkoutSession(incoming(), userId, sessionId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['notes']);
        allow delete: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
      }

      // Subcollection: Nutrition Logs
      match /nutritionLogs/{entryId} {
        allow get: if isValidId(userId) && isValidId(entryId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && isValidNutritionEntry(incoming(), userId, entryId)
          && incoming().createdAt == request.time
          && parentUserExists(userId);
        allow update: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && isValidNutritionEntry(incoming(), userId, entryId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'mealType', 'servings', 'calories', 'proteinG', 'carbsG', 'fatG'
          ]);
        allow delete: if isValidId(userId) && isValidId(entryId) && isOwner(userId);
      }

      // Subcollection: Daily Metrics (Hydration, Weight, Wearable Telemetry)
      match /dailyMetrics/{dateKey} {
        allow get: if isValidId(userId) && isValidDateKey(dateKey) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidDateKey(dateKey)
          && isOwner(userId)
          && isValidDailyMetric(incoming(), userId, dateKey)
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow update: if isValidId(userId)
          && isValidDateKey(dateKey)
          && isOwner(userId)
          && isValidDailyMetric(incoming(), userId, dateKey)
          && incoming().userId == existing().userId
          && incoming().dateKey == existing().dateKey
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'waterMl', 'weightKg', 'steps', 'activeCalories',
            'restingHeartRate', 'avgHeartRate', 'wearableSource', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidDateKey(dateKey) && isOwner(userId);
      }

      // Subcollection: Program Preferences (3-7 day rotations & 30/45/60m duration)
      match /programPreferences/{programId} {
        allow get: if isValidId(userId) && isValidId(programId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(programId)
          && isOwner(userId)
          && isValidProgramPreference(incoming(), userId, programId)
          && incoming().updatedAt == request.time
          && parentUserExists(userId);
        allow update: if isValidId(userId)
          && isValidId(programId)
          && isOwner(userId)
          && isValidProgramPreference(incoming(), userId, programId)
          && incoming().userId == existing().userId
          && incoming().programId == existing().programId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'rotationDays', 'targetMinutes', 'exerciseSwaps', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(programId) && isOwner(userId);
      }
    }
  }
}
