{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Personal fitness and nutrition goals and preferences for an authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "dailyCalorieGoal": {
          "type": "number"
        },
        "dailyProteinGoal": {
          "type": "number"
        },
        "dailyCarbsGoal": {
          "type": "number"
        },
        "dailyFatGoal": {
          "type": "number"
        },
        "macroMode": {
          "type": "string",
          "enum": ["recommended", "custom"]
        },
        "macroProteinPct": {
          "type": "number"
        },
        "macroCarbsPct": {
          "type": "number"
        },
        "macroFatPct": {
          "type": "number"
        },
        "weeklyWorkoutGoal": {
          "type": "number"
        },
        "dailyWaterGoalMl": {
          "type": "number"
        },
        "dailyStepGoal": {
          "type": "number"
        },
        "dailyActiveCaloriesGoal": {
          "type": "number"
        },
        "targetWeightKg": {
          "type": "number"
        },
        "currentWeightKg": {
          "type": "number"
        },
        "unitSystem": {
          "type": "string",
          "enum": ["imperial", "metric"]
        },
        "experienceLevel": {
          "type": "string",
          "enum": ["Beginner", "Intermediate", "Advanced"]
        },
        "heightCm": {
          "type": "number"
        },
        "age": {
          "type": "number"
        },
        "biologicalSex": {
          "type": "string",
          "enum": ["male", "female", "neutral"]
        },
        "activityLevel": {
          "type": "string",
          "enum": ["sedentary", "light", "moderate", "active", "very_active"]
        },
        "nutritionGoal": {
          "type": "string",
          "enum": ["lose_weight", "maintain", "build_muscle", "recomp", "performance"]
        },
        "activeProgramId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "activeDailyDurationDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10
        },
        "activeDailyDurationMinutes": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "dailyCalorieGoal",
        "dailyProteinGoal",
        "dailyCarbsGoal",
        "dailyFatGoal",
        "weeklyWorkoutGoal",
        "dailyWaterGoalMl",
        "dailyStepGoal",
        "dailyActiveCaloriesGoal",
        "targetWeightKg",
        "currentWeightKg",
        "unitSystem",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomProgram": {
      "title": "CustomProgram",
      "description": "User-created custom workout program with exercises, sets, reps, and rest timers.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "enum": ["Strength", "Hypertrophy", "Conditioning", "Mobility", "Custom"]
        },
        "difficulty": {
          "type": "string",
          "enum": ["Beginner", "Intermediate", "Advanced"]
        },
        "estimatedMinutes": {
          "type": "number"
        },
        "daysPerWeek": {
          "type": "number"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "exercises": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "title",
        "category",
        "difficulty",
        "estimatedMinutes",
        "daysPerWeek",
        "description",
        "exercises",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkoutSession": {
      "title": "WorkoutSession",
      "description": "Completed workout session record with volume, duration, and calories burned.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "programId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "programTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "durationMinutes": {
          "type": "number"
        },
        "caloriesBurned": {
          "type": "number"
        },
        "totalVolumeKg": {
          "type": "number"
        },
        "completedSets": {
          "type": "number"
        },
        "exercisesSummary": {
          "type": "array"
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "programId",
        "programTitle",
        "dateKey",
        "durationMinutes",
        "caloriesBurned",
        "totalVolumeKg",
        "completedSets",
        "exercisesSummary",
        "notes",
        "createdAt"
      ]
    },
    "NutritionEntry": {
      "title": "NutritionEntry",
      "description": "Logged food or drink entry with macros and optional barcode metadata.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "mealType": {
          "type": "string",
          "enum": ["breakfast", "lunch", "dinner", "snack"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "brand": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "barcode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "servingLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "servings": {
          "type": "number"
        },
        "calories": {
          "type": "number"
        },
        "proteinG": {
          "type": "number"
        },
        "carbsG": {
          "type": "number"
        },
        "fatG": {
          "type": "number"
        },
        "source": {
          "type": "string",
          "enum": ["barcode", "search", "manual"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "dateKey",
        "mealType",
        "name",
        "brand",
        "barcode",
        "servingLabel",
        "servings",
        "calories",
        "proteinG",
        "carbsG",
        "fatG",
        "source",
        "createdAt"
      ]
    },
    "DailyMetric": {
      "title": "DailyMetric",
      "description": "Daily hydration, body weight, and synced wearable activity telemetry (steps, heart rate, active calories).",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "waterMl": {
          "type": "number"
        },
        "weightKg": {
          "type": "number"
        },
        "steps": {
          "type": "number"
        },
        "activeCalories": {
          "type": "number"
        },
        "restingHeartRate": {
          "type": "number"
        },
        "avgHeartRate": {
          "type": "number"
        },
        "wearableSource": {
          "type": "string",
          "enum": ["manual", "fitbit", "apple_health", "garmin", "strava", "bluetooth_hr"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "dateKey",
        "waterMl",
        "weightKg",
        "steps",
        "activeCalories",
        "restingHeartRate",
        "avgHeartRate",
        "wearableSource",
        "updatedAt"
      ]
    },
    "ProgramPreference": {
      "title": "ProgramPreference",
      "description": "User-selected rotation length (3-7 days) and workout duration (30, 45, or 60 min) for any workout program.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "programId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "rotationDays": {
          "type": "number"
        },
        "targetMinutes": {
          "type": "number"
        },
        "exerciseSwaps": {
          "type": "object",
          "description": "Map of original exercise IDs to replacement exercise IDs for equipment substitution."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "programId",
        "rotationDays",
        "targetMinutes",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user goals and unit preferences."
    },
    "/users/{userId}/customPrograms/{programId}": {
      "schema": { "$ref": "#/entities/CustomProgram" },
      "description": "User's custom workout programs."
    },
    "/users/{userId}/workoutSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/WorkoutSession" },
      "description": "Completed workout history for a user."
    },
    "/users/{userId}/nutritionLogs/{entryId}": {
      "schema": { "$ref": "#/entities/NutritionEntry" },
      "description": "Logged food and drink entries for a user."
    },
    "/users/{userId}/dailyMetrics/{dateKey}": {
      "schema": { "$ref": "#/entities/DailyMetric" },
      "description": "Daily hydration, weight, and wearable activity telemetry."
    },
    "/users/{userId}/programPreferences/{programId}": {
      "schema": { "$ref": "#/entities/ProgramPreference" },
      "description": "Per-program rotation length and workout duration preferences."
    }
  }
}
